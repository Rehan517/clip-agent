{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Learning",
  "env": {
    "AWS_PROFILE": "clip-readonly",
    "AWS_REGION": "us-east-1",
    "AWS_DEFAULT_REGION": "us-east-1",
    "AWS_PAGER": ""
  },
  "enabledMcpjsonServers": ["aws-knowledge"],
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "mcp__aws-knowledge",
      "Bash(aws sts get-caller-identity)",
      "Bash(aws logs tail *)",
      "Bash(aws logs filter-log-events *)",
      "Bash(aws stepfunctions list-executions *)",
      "Bash(aws stepfunctions describe-execution *)",
      "Bash(aws stepfunctions get-execution-history *)",
      "Bash(aws dynamodb get-item *)",
      "Bash(aws dynamodb query *)",
      "Bash(aws s3 ls *)",
      "Bash(cdk synth *)",
      "Bash(cdk diff *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)"
    ],
    "deny": [
      "Bash(cdk deploy *)",
      "Bash(npx cdk deploy *)",
      "Bash(cdk destroy *)",
      "Bash(npx cdk destroy *)",
      "Bash(cdk bootstrap *)",
      "Bash(agentcore deploy *)",
      "Bash(agentcore remove *)",
      "Bash(aws configure *)",
      "Bash(aws sso *)",
      "Bash(* --profile clip)",
      "Bash(* --profile clip *)",
      "Bash(git push *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/**)"
    ]
  }
}
